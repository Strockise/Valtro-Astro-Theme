---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
---

<BaseLayout ixPage="6ac69645ebf308dc9ba19a39" title="Not Found" bare noindex>
  <div class="utility-page-wrap">
    <Header />
    <div class="utility-page-content">
      <div class="not-found-content-block">
        <div class="not-found-text-block">
          <div class="not-found-text">4<span class="not-found-highlight-text">0</span>4</div>
        </div>
        <div class="not-found-heding-block">
          <h2 class="utitlity-title">Oops! Page not found</h2>
          <div class="utility-summary">Oops! It seems like you've ventured into uncharted territory. The page you're looking for might have been moved, deleted, or never existed. Don't worry; let's get you back on track.</div>
        </div>
        <div class="not-found-button-block">
          <a data-w-id="207302cf-ffa7-25c0-16f9-55a7509d0802" href="/" class="tartiary-button w-inline-block">
            <div class="button-content-block is-1">
              <div class="button-text">Go To Home</div>
            </div>
            <div class="button-hover-bg-block">
              <div class="button-hover-transition button-transition-rounded is-2">
                <div class="button-content-block is-2">
                  <div class="button-text is-2">Go To Home</div>
                </div>
              </div>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
