---
// Set PUBLIC_FORM_ENDPOINT to any service that accepts a POST with form data
// (Formspree, Basin, Getform, your own API...). Without it the form runs in
// demo mode and only shows the success message.
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
---

<div data-w-id="0d05970b-26f6-6913-db5d-590a6b187abc" style="opacity:0;filter:blur(15px);-webkit-transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 60px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)" class="contact-form-block">
  <div class="contact-form w-form">
    <form id="email-form" name="email-form" data-name="Email Form" method="post" action={endpoint || undefined} data-endpoint={endpoint} class="contact-form-inner-block" data-wf-page-id="6ac69645ebf308dc9ba19a36" data-wf-element-id="0d05970b-26f6-6913-db5d-590a6b187abe">
      <div class="contact-form-heading-block">
        <h2 class="contact-form-title">Fill out the form</h2>
        <p class="contact-form-summary">Fill out the form and we’ll get back to you within 24 hours. Whether it’s about pricing, integrations, or a custom CRM setup, we’ve got you covered.</p>
      </div>
      <div class="contact-form-content-block">
        <div class="form-field-block"><label for="name" class="form-field-label">Your Name</label><input class="form-text-field w-input" maxlength="256" name="name" data-name="Name" placeholder="Your full name" type="text" id="name" autocomplete="name" required /></div>
        <div class="form-field-block"><label for="email" class="form-field-label">Your Email</label><input class="form-text-field w-input" maxlength="256" name="email" data-name="email" placeholder="Write your email" type="email" id="email" autocomplete="email" required /></div>
        <div class="form-field-block"><label for="phone-number" class="form-field-label">Your phone</label><input class="form-text-field w-input" maxlength="256" name="phone-number" data-name="phone number" placeholder="Your phone number" type="tel" id="phone-number" autocomplete="tel" required /></div>
        <div class="form-field-block"><label for="field" class="form-field-label">Message</label><textarea id="field" name="message" maxlength="5000" data-name="Field" placeholder="Example Text" class="form-text-field lg w-input"></textarea></div>
      </div>
      <div class="form-button-block"><input type="submit" data-wait="Please wait..." class="form-button w-button" value="Submit" /></div>
    </form>
    <div class="success-message w-form-done" tabindex="-1" role="region" aria-label="Email Form success">
      <div>Thank you! Your submission has been received!</div>
    </div>
    <div class="error-message w-form-fail" tabindex="-1" role="region" aria-label="Email Form failure">
      <div>Oops! Something went wrong while submitting the form.</div>
    </div>
  </div>
</div>

<script>
  // Replaces Webflow's hosted form handler (which only works on webflow.io)
  // while keeping the exact same success / error UI.
  document.querySelectorAll<HTMLFormElement>('.w-form form[data-endpoint]').forEach((form) => {
    const wrapper = form.closest('.w-form');
    const done = wrapper?.querySelector<HTMLElement>(':scope > .w-form-done');
    const fail = wrapper?.querySelector<HTMLElement>(':scope > .w-form-fail');
    const button = form.querySelector<HTMLInputElement>('input[type="submit"]');

    const finish = (success: boolean) => {
      form.style.display = success ? 'none' : '';
      if (done) done.style.display = success ? 'block' : 'none';
      if (fail) fail.style.display = success ? 'none' : 'block';
      (success ? done : fail)?.focus();
    };

    form.addEventListener('submit', async (event) => {
      // Stop webflow.js' delegated handler from also processing the submit.
      event.preventDefault();
      event.stopPropagation();

      const endpoint = form.dataset.endpoint;
      const label = button?.value ?? '';
      if (button) {
        button.disabled = true;
        button.value = button.dataset.wait || label;
      }

      let success = true;
      if (endpoint) {
        try {
          const response = await fetch(endpoint, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
          success = response.ok;
        } catch {
          success = false;
        }
      } else {
        console.info('[contact form] PUBLIC_FORM_ENDPOINT is not set; running in demo mode.');
      }

      if (button) {
        button.disabled = false;
        button.value = label;
      }
      finish(success);
    });
  });
</script>
