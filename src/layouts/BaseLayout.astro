---
import { Font } from 'astro:assets';
import config from '@/config/config.json';
import SeoMeta, { type Props as SeoProps } from '@/components/seo/SeoMeta.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';

import '@/styles/normalize.css';
import '@/styles/webflow.css';
import '@/styles/valtro.css';

interface Props extends SeoProps {
  /**
   * Webflow page ID. The bundled webflow.js keys its interactions
   * (scroll/load/hover animations) to this ID, so every page must keep it.
   */
  wfPage: string;
  /** Render the slot as-is, without page wrapper, header or footer (404, 401). */
  bare?: boolean;
}

const { wfPage, bare = false, ...seo } = Astro.props;
---

<!doctype html>
<html data-wf-page={wfPage} data-wf-site={config.webflow.site_id} lang={config.site.lang}>
  <head>
    <meta charset="utf-8" />
    <SeoMeta {...seo} />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-geist" />
    <script is:inline>!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>
    <link href="/images/favicon.png" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: light)" />
    <link href="/images/favicon-dark.png" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)" />
    <link href="/images/webclip.png" rel="apple-touch-icon" />
  </head>
  <body>
    {
      bare ? (
        <slot />
      ) : (
        <div class="page-wrapper">
          <Header />
          <main class="main-wrapper">
            <slot />
          </main>
          <Footer />
        </div>
      )
    }
    <script is:inline src="/js/jquery-3.5.1.min.js"></script>
    <script is:inline src="/js/webflow.js"></script>
  </body>
</html>
