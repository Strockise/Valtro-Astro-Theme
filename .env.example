# Public URL of the deployed site (canonical URLs, Open Graph, sitemap).
SITE_URL=https://example.com

# Strapi backend that provides the Blog Posts and Authors collections.
STRAPI_URL=http://localhost:1337

# Optional read-only Strapi API token (Settings > API Tokens > "Read-only").
# Required only if the Public role has no read access (STRAPI_PUBLIC_READ=false in Strapi).
STRAPI_API_TOKEN=

# Optional endpoint that receives the contact form as a POST (Formspree, Basin, your own API...).
# Leave empty to run the form in demo mode.
PUBLIC_FORM_ENDPOINT=
