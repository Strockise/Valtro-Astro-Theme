{
  "kind": "collectionType",
  "collectionName": "blog_posts",
  "info": {
    "singularName": "blog-post",
    "pluralName": "blog-posts",
    "displayName": "Blog Post",
    "description": "Articles rendered on /blog, /blog-post/[slug] and the Home Two blog section."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 160
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "summary": {
      "type": "text",
      "maxLength": 300
    },
    "isFeatured": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "featuredText": {
      "type": "string",
      "maxLength": 60
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "mainImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author",
      "inversedBy": "blogPosts"
    },
    "publishedDate": {
      "type": "date",
      "required": true
    },
    "readingTime": {
      "type": "string",
      "maxLength": 20
    },
    "content": {
      "type": "richtext",
      "required": true
    }
  }
}
